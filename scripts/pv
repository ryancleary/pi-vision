#!/usr/bin/env python3
"""pi-vision build tool.

  scripts/pv targets                          list image targets
  scripts/pv build desktop [--preset NAME]    configure, build and test the desktop app
  scripts/pv build image TARGET               build the Yocto image for TARGET
  scripts/pv build all                        every desktop preset and every image target
  scripts/pv size TARGET                      sizes of the last image built for TARGET
  scripts/pv run TARGET [options]             boot a QEMU target's image (see: run --help)
  scripts/pv stop TARGET                      stop a QEMU target started with run --background
  scripts/pv logs TARGET [options]            collect logs into logs/TARGET/ (see: logs --help)

Image targets are defined in targets/<name>.json. Each points at a kas file,
which stays the source of truth for the Yocto configuration.
"""

import argparse
import json
import os
import re
import shlex
import shutil
import tarfile
import tempfile
import subprocess
import sys
import time
from datetime import datetime
from datetime import datetime
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
TARGETS_DIR = REPO / "targets"
LOG_ROOT = REPO / "build-logs"
KAS = REPO / "scripts" / "kas.sh"
DEPLOY_DIR = REPO / "yocto" / "build" / "tmp" / "deploy" / "images"
QEMU_STATE_DIR = LOG_ROOT / "qemu"
DEVICE_LOG_ROOT = REPO / "logs"
CRASH_DIR_ON_DEVICE = "/var/crash"
SSH_OPTIONS = ["-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
               "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=10"]

DESKTOP_PRESETS = ["debug", "release"]
TESTED_PRESETS = {"debug"}  # presets that have a matching ctest preset
REQUIRED_TARGET_KEYS = ["description", "kas", "machine", "image", "delivery"]


def fail(message):
    print(f"pv: {message}", file=sys.stderr)
    sys.exit(1)


def load_targets():
    targets = {}
    for path in sorted(TARGETS_DIR.glob("*.json")):
        with path.open() as f:
            data = json.load(f)
        missing = [key for key in REQUIRED_TARGET_KEYS if key not in data]
        if missing:
            fail(f"{path.relative_to(REPO)} is missing: {', '.join(missing)}")
        data["name"] = path.stem
        targets[path.stem] = data
    return targets


def get_target(name):
    targets = load_targets()
    if name not in targets:
        fail(f"unknown target '{name}'. Known targets: {', '.join(targets) or 'none'}")
    return targets[name]


def run(command, log=None):
    """Run a command from the repo root. Output goes to the terminal and, if given, a log file."""
    line = "$ " + " ".join(str(part) for part in command)
    print(line, flush=True)
    if log is None:
        return subprocess.run(command, cwd=REPO).returncode

    log.write(line + "\n")
    process = subprocess.Popen(command, cwd=REPO, stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, text=True, errors="replace")
    for output in process.stdout:
        sys.stdout.write(output)
        log.write(output)
    log.flush()
    return process.wait()


def desktop_commands(preset):
    commands = [
        ["cmake", "--preset", preset],
        ["cmake", "--build", "--preset", preset],
    ]
    if preset in TESTED_PRESETS:
        commands.append(["ctest", "--preset", preset])
    return commands


def image_commands(target):
    return [[str(KAS), "build", target["kas"]]]


def check_desktop_environment():
    missing = [name for name in ("QT_ROOT_DIR", "OPENCV_ROOT_DIR") if not os.environ.get(name)]
    if missing:
        fail(f"{', '.join(missing)} not set; the CMake presets need them to find Qt and OpenCV")


def run_step(commands, log=None):
    for command in commands:
        if run(command, log) != 0:
            return False
    return True


def format_duration(seconds):
    minutes, seconds = divmod(int(seconds), 60)
    hours, minutes = divmod(minutes, 60)
    return f"{hours}h{minutes:02d}m" if hours else f"{minutes}m{seconds:02d}s"


def build_all():
    check_desktop_environment()
    steps = [(f"desktop {preset}", desktop_commands(preset)) for preset in DESKTOP_PRESETS]
    steps += [(f"image {name}", image_commands(target)) for name, target in load_targets().items()]

    log_dir = LOG_ROOT / datetime.now().strftime("%Y%m%d-%H%M%S")
    log_dir.mkdir(parents=True)
    print(f"Logs: {log_dir.relative_to(REPO)}")

    results = []
    for name, commands in steps:
        print(f"\n=== {name} ===", flush=True)
        log_path = log_dir / (name.replace(" ", "-") + ".log")
        start = time.monotonic()
        with log_path.open("w") as log:
            ok = run_step(commands, log)
        results.append((name, ok, time.monotonic() - start, log_path))

    summary = ["", "=== Summary ==="]
    for name, ok, seconds, log_path in results:
        status = "ok    " if ok else "FAILED"
        summary.append(f"{status}  {name:<24} {format_duration(seconds):>8}  {log_path.relative_to(REPO)}")
    text = "\n".join(summary)
    print(text)
    (log_dir / "summary.txt").write_text(text.strip() + "\n")

    return 0 if all(ok for _, ok, _, _ in results) else 1


def human_size(size):
    for unit in ("B", "KB", "MB", "GB"):
        if size < 1024 or unit == "GB":
            return f"{size:.1f} {unit}" if unit != "B" else f"{size} B"
        size /= 1024


def show_size(target):
    image_dir = DEPLOY_DIR / target["machine"]
    prefix = f"{target['image']}-{target['machine']}.rootfs."
    files = sorted(image_dir.glob(prefix + "*"))
    if not files:
        fail(f"no image found in {image_dir.relative_to(REPO)}; build it with: scripts/pv build image {target['name']}")

    print(f"{target['name']} ({target['machine']})")
    for path in files:
        print(f"  {human_size(path.resolve().stat().st_size):>10}  {path.name}")

    manifest = image_dir / (prefix + "manifest")
    if manifest.exists():
        packages = [line for line in manifest.read_text().splitlines() if line.strip()]
        print(f"  {len(packages)} packages installed (see {manifest.name})")
    return 0


def kvm_available():
    return os.access("/dev/kvm", os.R_OK | os.W_OK)


def qemu_command(target, args):
    qemu = target.get("qemu")
    if target["delivery"] != "qemu" or not qemu:
        fail(f"{target['name']} is delivered by {target['delivery']}, not QEMU")

    image_dir = DEPLOY_DIR / target["machine"]
    kernel = image_dir / qemu["kernel"]
    rootfs = image_dir / f"{target['image']}-{target['machine']}.rootfs.{qemu['rootfs']}"
    for path in (kernel, rootfs):
        if not path.exists():
            fail(f"{path.relative_to(REPO)} not found; build it with: scripts/pv build image {target['name']}")

    command = [qemu["binary"]]
    if kvm_available():
        command += ["-enable-kvm", "-cpu", "host"]
    else:
        print("pv: /dev/kvm not available, using software emulation (slow)", file=sys.stderr)

    drive = f"file={rootfs},if=virtio,format=raw"
    if not args.persist:
        drive += ",snapshot=on"  # changes are discarded; the built image stays untouched

    forwards = f"hostfwd=tcp::{args.ssh_port}-:22,hostfwd=tcp::{args.vnc_port}-:5900"
    command += [
        "-smp", str(qemu["cpus"]),
        "-m", str(args.memory or qemu["memory"]),
        "-kernel", str(kernel),
        "-append", qemu["append"],
        "-drive", drive,
        "-netdev", f"user,id=net0,{forwards}",
        "-device", "virtio-net-pci,netdev=net0",
    ]
    if args.background:
        # No terminal to attach to: the serial console goes to a log file instead.
        command += ["-serial", f"file:{qemu_console_log(target)}"]
    else:
        command += ["-serial", "mon:stdio"]
    if args.display == "none":
        command += ["-display", "none"]
    else:
        command += ["-device", "virtio-vga-gl", "-display", f"{args.display},gl=on"]
    return command


def qemu_console_log(target):
    return QEMU_STATE_DIR / f"{target['name']}.console.log"


def qemu_pid_file(target):
    return QEMU_STATE_DIR / f"{target['name']}.pid"


def running_pid(target):
    """PID of a background QEMU for this target, or None if it isn't running."""
    pid_file = qemu_pid_file(target)
    try:
        pid = int(pid_file.read_text())
        os.kill(pid, 0)  # signal 0: only checks the process exists
        return pid
    except (OSError, ValueError):
        pid_file.unlink(missing_ok=True)
        return None


def run_qemu(target, args):
    if args.background:
        QEMU_STATE_DIR.mkdir(parents=True, exist_ok=True)
        pid = running_pid(target)
        if pid:
            fail(f"{target['name']} is already running (pid {pid}); stop it with: scripts/pv stop {target['name']}")

    command = qemu_command(target, args)
    if args.dry_run:
        print(shlex.join(command))
        return 0

    ssh = (f"ssh -p {args.ssh_port} -o StrictHostKeyChecking=no "
           f"-o UserKnownHostsFile=/dev/null root@localhost")
    vnc = f"vncviewer localhost:{args.vnc_port}"

    if not args.background:
        print("Console is in this terminal; log in as root. Quit: Ctrl+A then X.")
        print(f"SSH: {ssh}")
        print(f"VNC (QT_QPA_PLATFORM=vnc in the guest): {vnc}", flush=True)
        os.execvp(command[0], command)

    # Detached from this terminal: its own session, no stdin. QEMU's own messages go to
    # a separate log, since the guest console log is written by QEMU itself.
    qemu_log = QEMU_STATE_DIR / f"{target['name']}.qemu.log"
    with qemu_log.open("w") as log:
        process = subprocess.Popen(command, cwd=REPO, stdin=subprocess.DEVNULL,
                                   stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    time.sleep(1)
    if process.poll() is not None:
        fail(f"QEMU exited immediately; see {qemu_log.relative_to(REPO)}")
    qemu_pid_file(target).write_text(f"{process.pid}\n")

    print(f"{target['name']} running in the background (pid {process.pid}).")
    print(f"Console log: tail -f {qemu_console_log(target).relative_to(REPO)}")
    print(f"SSH (once booted): {ssh}")
    print(f"VNC (QT_QPA_PLATFORM=vnc in the guest): {vnc}")
    print(f"Stop: scripts/pv stop {target['name']}")
    return 0


def stop_qemu(target):
    pid = running_pid(target)
    if not pid:
        print(f"{target['name']} is not running")
        return 0
    os.kill(pid, 15)  # SIGTERM: QEMU shuts the VM down and exits
    for _ in range(50):
        if running_pid(target) is None:
            break
        time.sleep(0.1)
    else:
        fail(f"pid {pid} did not exit; kill it with: kill -9 {pid}")
    qemu_pid_file(target).unlink(missing_ok=True)
    print(f"Stopped {target['name']} (pid {pid})")
    return 0



# --- logs -------------------------------------------------------------------

PRIORITIES = ["emerg", "alert", "crit", "err", "warning", "notice", "info", "debug"]
DUMP_NAME = re.compile(r"^\d{6}_")


def entry_message(entry):
    """journalctl -o json gives MESSAGE as a string, or as a byte list when it isn't UTF-8."""
    message = entry.get("MESSAGE", "")
    if isinstance(message, list):
        return bytes(message).decode("utf-8", errors="replace")
    return message or ""


def format_entry(entry):
    try:
        stamp = datetime.fromtimestamp(int(entry["__REALTIME_TIMESTAMP"]) / 1e6)
        when = stamp.strftime("%Y-%m-%d %H:%M:%S.") + f"{stamp.microsecond // 1000:03d}"
    except (KeyError, ValueError):
        when = "????-??-?? ??:??:??.???"
    ident = entry.get("SYSLOG_IDENTIFIER") or entry.get("_COMM") or "?"
    pid = entry.get("_PID") or entry.get("SYSLOG_PID")
    try:
        priority = PRIORITIES[int(entry.get("PRIORITY", 6))]
    except (ValueError, IndexError):
        priority = "info"
    source = f"{ident}[{pid}]" if pid else ident
    return f"{when} {source} {priority}: {entry_message(entry)}\n"


def our_unit(entry):
    """The pi-vision unit an entry belongs to, if any. Messages a service writes carry
    _SYSTEMD_UNIT; systemd's own messages about it (start, exit, restart) carry UNIT."""
    for field in ("_SYSTEMD_UNIT", "UNIT"):
        unit = entry.get(field, "")
        if unit.startswith("pivision"):
            return unit.removesuffix(".service")
    return None


class LogWriter:
    """Writes every journal entry to system.log and ours also to <service>.log."""

    def __init__(self, directory, flush_each=False):
        self.directory = directory
        self.directory.mkdir(parents=True, exist_ok=True)
        self.flush_each = flush_each
        self.system = (directory / "system.log").open("w")
        self.services = {}
        self.count = 0

    def write_json_line(self, line):
        line = line.strip()
        if not line:
            return
        try:
            entry = json.loads(line)
        except json.JSONDecodeError:
            return
        text = format_entry(entry)
        self.system.write(text)
        unit = our_unit(entry)
        if unit:
            if unit not in self.services:
                self.services[unit] = (self.directory / f"{unit}.log").open("w")
            self.services[unit].write(text)
        self.count += 1
        if self.flush_each:
            self.flush()

    def flush(self):
        self.system.flush()
        for f in self.services.values():
            f.flush()

    def close(self):
        self.system.close()
        for f in self.services.values():
            f.close()

    def summary(self):
        files = ["system.log"] + [f"{name}.log" for name in sorted(self.services)]
        return f"{self.count} entries -> {self.directory.relative_to(REPO)}/ ({', '.join(files)})"


def ssh_command(target, args, remote):
    ssh = target.get("ssh", {})
    host = args.host or ssh.get("host")
    port = args.port or ssh.get("port", 22)
    if not host:
        fail(f"no address for {target['name']}; pass --host (e.g. --host 192.168.1.50)")
    return ["ssh", "-p", str(port), *SSH_OPTIONS, f"{ssh.get('user', 'root')}@{host}", remote]


def update_latest(target_dir, session_dir):
    latest = target_dir / "latest"
    if latest.is_symlink() or latest.exists():
        latest.unlink()
    latest.symlink_to(session_dir.name)


def collect_live(target, args):
    target_dir = DEVICE_LOG_ROOT / target["name"]
    session = target_dir / datetime.now().strftime("%Y-%m-%d_%H%M%S")
    writer = LogWriter(session, flush_each=args.follow)
    update_latest(target_dir, session)

    remote = "journalctl -b -o json --no-pager" + (" -f" if args.follow else "")
    command = ssh_command(target, args, remote)
    if args.follow:
        print(f"Following {target['name']} into {session.relative_to(REPO)}/ (Ctrl+C to stop)",
              flush=True)

    process = subprocess.Popen(command, stdout=subprocess.PIPE, text=True, errors="replace")
    try:
        for line in process.stdout:
            writer.write_json_line(line)
    except KeyboardInterrupt:
        process.terminate()
    finally:
        writer.close()
    status = process.wait()
    if status not in (0, -15) and writer.count == 0:
        fail(f"ssh returned {status}; is {target['name']} running and reachable?")
    print(writer.summary())
    return 0


def convert_dumps(target, dumps_dir):
    """Turns crash dumps (as saved by crash-dump) into readable logs under logs/TARGET/crashes/."""
    journalctl = shutil.which("journalctl")
    if not journalctl:
        fail("journalctl not found; it's needed to read the saved journal files")

    dumps = sorted(p for p in dumps_dir.iterdir() if p.is_dir() and DUMP_NAME.match(p.name))
    if not dumps:
        print(f"No crash dumps in {dumps_dir}")
        return 0

    out_root = DEVICE_LOG_ROOT / target["name"] / "crashes"
    for dump in dumps:
        writer = LogWriter(out_root / dump.name)
        output = subprocess.run([journalctl, "--directory", str(dump / "journal"), "-o", "json",
                                 "--no-pager"], capture_output=True, text=True, errors="replace")
        for line in output.stdout.splitlines():
            writer.write_json_line(line)
        writer.close()
        if (dump / "summary.txt").exists():
            shutil.copy(dump / "summary.txt", writer.directory / "summary.txt")
        print(writer.summary())
    return 0


def collect_crashes_over_ssh(target, args):
    command = ssh_command(target, args, f"tar -C {CRASH_DIR_ON_DEVICE} -cf - .")
    with tempfile.TemporaryDirectory() as tmp:
        archive = Path(tmp) / "crash.tar"
        with archive.open("wb") as out:
            if subprocess.run(command, stdout=out).returncode != 0:
                fail(f"could not read {CRASH_DIR_ON_DEVICE} on {target['name']}")
        extracted = Path(tmp) / "crash"
        extracted.mkdir()
        with tarfile.open(archive) as tar:
            tar.extractall(extracted, filter="data")
        return convert_dumps(target, extracted)


def collect_logs(target, args):
    if args.card:
        card = Path(args.card).expanduser()
        if not card.is_dir():
            fail(f"{card} is not a directory; mount the card's 'crash' partition and pass its path")
        return convert_dumps(target, card)
    if args.crashes:
        return collect_crashes_over_ssh(target, args)
    return collect_live(target, args)


def main():
    parser = argparse.ArgumentParser(prog="pv", description="pi-vision build tool")
    commands = parser.add_subparsers(dest="command", required=True)

    commands.add_parser("targets", help="list image targets")

    build = commands.add_parser("build", help="build desktop, an image, or everything")
    build.add_argument("what", choices=["desktop", "image", "all"])
    build.add_argument("target", nargs="?", help="image target (for 'build image')")
    build.add_argument("--preset", default="debug", choices=DESKTOP_PRESETS,
                       help="CMake preset for 'build desktop' (default: debug)")

    size = commands.add_parser("size", help="show image sizes for a target")
    size.add_argument("target")

    run = commands.add_parser("run", help="boot a QEMU target's image")
    run.add_argument("target")
    run.add_argument("--display", default="sdl", choices=["sdl", "gtk", "none"],
                     help="QEMU window type, or none for SSH/VNC only (default: sdl)")
    run.add_argument("--memory", type=int, help="RAM in MB (default: from the target file)")
    run.add_argument("--ssh-port", type=int, default=2222, help="host port for guest SSH (default: 2222)")
    run.add_argument("--vnc-port", type=int, default=5900, help="host port for guest VNC (default: 5900)")
    run.add_argument("--persist", action="store_true",
                     help="keep changes made in the guest (default: discard them)")
    run.add_argument("-b", "--background", action="store_true",
                     help="return the terminal; console goes to a log file, use SSH to log in")
    run.add_argument("--dry-run", action="store_true", help="print the QEMU command instead of running it")

    stop = commands.add_parser("stop", help="stop a QEMU target started with run --background")
    stop.add_argument("target")

    logs = commands.add_parser(
        "logs", help="collect logs into logs/TARGET/",
        description="Without options: this boot's journal over SSH, as system.log plus one "
                    "file per pi-vision service, in logs/TARGET/<time>/ (logs/TARGET/latest "
                    "points at it).")
    logs.add_argument("target")
    logs.add_argument("-f", "--follow", action="store_true", help="keep collecting until Ctrl+C")
    logs.add_argument("--crashes", action="store_true",
                      help="fetch saved crash dumps over SSH instead of the live journal")
    logs.add_argument("--card", metavar="DIR",
                      help="read crash dumps from the SD card's 'crash' partition mounted at DIR")
    logs.add_argument("--host", help="device address (default: from the target file)")
    logs.add_argument("--port", type=int, help="SSH port (default: from the target file)")

    args = parser.parse_args()

    if args.command == "targets":
        for name, target in load_targets().items():
            print(f"{name:<14} {target['description']}  [{target['kas']}, delivered by {target['delivery']}]")
        return 0

    if args.command == "size":
        return show_size(get_target(args.target))

    if args.command == "run":
        return run_qemu(get_target(args.target), args)

    if args.command == "stop":
        return stop_qemu(get_target(args.target))

    if args.command == "logs":
        return collect_logs(get_target(args.target), args)

    if args.what == "desktop":
        check_desktop_environment()
        return 0 if run_step(desktop_commands(args.preset)) else 1
    if args.what == "image":
        if not args.target:
            fail("build image needs a target; see: scripts/pv targets")
        return 0 if run_step(image_commands(get_target(args.target))) else 1
    return build_all()


if __name__ == "__main__":
    sys.exit(main())
